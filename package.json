{
  "name": "fidelio-frontdesk-ui",
  "version": "0.1.0",
  "description": "Micros-Fidelio inspired hotel operations UI prototype",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --watch",
    "db:where": "node scripts/db-target.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "tailwindcss": "^3.4.19"
  }
}
